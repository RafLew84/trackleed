{
  "candidate_semantics": {
    "finite_candidate_fit": {
      "all_of": [
        "proposal_available",
        "roi_valid",
        "solver_completed",
        "finite:center_x",
        "finite:center_y",
        "finite:amplitude",
        "finite:r_squared",
        "finite:sigma_x",
        "finite:sigma_y"
      ],
      "evaluated_before": "acceptance_gates"
    },
    "gate_margin_audit": {
      "inclusive_bounds": true,
      "near_width_boundary_rule": "either sigma_x or sigma_y has width_boundary_distance <= 0.05",
      "passing_signed_margin": ">= 0",
      "trigger_count_rule": "count >= ceil(0.05 * finite_candidate_fit_n)",
      "trigger_scope": "computed separately per method on the central variant",
      "width_boundary_distance": "min(abs(sigma - sigma_min), abs(sigma_max - sigma)) / (sigma_max - sigma_min)"
    },
    "rejection_reporting": {
      "first_reason_order": [
        "proposal_unavailable",
        "roi_invalid",
        "solver_failure",
        "non_finite_parameters",
        "proposal_to_fit",
        "r_squared",
        "amplitude",
        "width",
        "physics_branch_consistency"
      ],
      "full_reasons": "retain every failed gate in evaluation order"
    },
    "width_only_rejection": {
      "definition": "width gate fails while proposal, ROI, solver, finite-parameter, proposal-to-fit, r_squared and amplitude requirements pass",
      "includes_physics_branch_consistency": false,
      "reference_opportunity_count": 221,
      "trigger_count": 12
    }
  },
